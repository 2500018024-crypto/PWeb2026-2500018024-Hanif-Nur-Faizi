<div class="box">
    <h2>Sistem Nilai Mahasiswa</h2>
    <form action="" method="POST">
        <input type="text" name="cari_nama" placeholder="Cari nama..." value="<?php echo htmlspecialchars($cari_nama); ?>">
        <input type="submit" value="Cari"><br><br>
        <button type="submit" name="urut" value="asc">Nilai Terendah (asort)</button>
        <button type="submit" name="urut" value="desc">Nilai Tertinggi (arsort)</button>
    </form>
    <?php echo $pesan_cari; ?>
    <table>
        <tr><th>Nama</th><th>Nilai</th></tr>
        <?php foreach ($data_mahasiswa as $nama => $nilai) : ?>
            <tr><td><?php echo $nama; ?></td><td><?php echo $nilai; ?></td></tr>
        <?php endforeach; ?>
    </table>
    <p><b>Total Mahasiswa:</b> <?php echo count($data_mahasiswa); ?></p>
    <p><b>Rata-rata Nilai:</b> <?php echo hitungRataRata($data_mahasiswa); ?></p>
