<?php
// 1. Deklarasi Array Asosiatif (Nama => Nilai)
$data_mahasiswa = [
    "Hanif" => 95,
    "Budi" => 80,
    "Siti" => 88,
    "Andi" => 75,
    "Rani" => 90
];

// 2. Custom Function untuk menghitung rata-rata nilai
function hitungRataRata($array_nilai) {
    $total = array_sum($array_nilai);
    $jumlah_data = count($array_nilai); // Fungsi count() array
    return $jumlah_data > 0 ? ($total / $jumlah_data) : 0;
}

$mode_urut = $_POST['urut'] ?? 'default';
$cari_nama = $_POST['cari_nama'] ?? '';
$pesan_cari = "";

// 3. Penerapan Fungsi Pengurutan Array (Sorting)
if ($mode_urut == 'asc') {
    asort($data_mahasiswa); // Mengurutkan nilai menaik (asort)
} elseif ($mode_urut == 'desc') {
    arsort($data_mahasiswa); // Mengurutkan nilai menurun (arsort)
}

// 4. Penerapan Fungsi Pencarian Array
if (!empty($cari_nama)) {
    if (array_key_exists($cari_nama, $data_mahasiswa)) {
        $pesan_cari = "<p style='color:green;'>Mahasiswa <b>$cari_nama</b> ditemukan. Nilai: <b>".$data_mahasiswa[$cari_nama]."</b></p>";
    } else {
        $pesan_cari = "<p style='color:red;'>Mahasiswa '$cari_nama' tidak ditemukan.</p>";
    }
}
?>
